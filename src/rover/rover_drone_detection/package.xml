<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_drone_detection</name>
  <version>0.0.0</version>
  <description>
    Camera-based detection of waiter FPV drones (ambush drones sitting by the road): YOLO on the camera stream, the boxes as vision_msgs detections and drawn on an annotated image for the operator.
  </description>
  <maintainer email="andriykulbabapetrovych@gmail.com">andrii</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- ultralytics (+ torch) has no rosdep key: pip install -r requirements.txt -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
