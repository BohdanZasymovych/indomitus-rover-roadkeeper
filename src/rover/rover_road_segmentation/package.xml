<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_road_segmentation</name>
  <version>0.0.0</version>
  <description>
    Few-shot DINOv2 (dinov2_vits14, frozen) binary road segmentation: camera image in, mono8
    0/1 road mask out on /rover/perception/road_mask for rover_road_assist's road_deviation_node.
  </description>
  <maintainer email="bohdan.zasymovych@gmail.com">bohdan</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- torch / torchvision are not in rosdep for Jetson: install the JetPack wheels (see README.md). -->

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rover_road_assist</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
